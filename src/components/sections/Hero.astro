---
import { Icon } from 'astro-icon/components';
import Button from '@/components/ui/Button.astro';
import { getLangFromUrl, useTranslations } from '@/i18n';
import { pathFor } from '@/i18n/routes';
import { whatsappUrl } from '@/lib/whatsapp';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const channels = ['Falabella', 'AlCarrito', 'App Brilla'];
---

<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="container-page grid items-center gap-12 pt-12 pb-16 sm:pt-20 sm:pb-24 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-sm text-muted">
        <span class="relative flex size-2.5" aria-hidden="true">
          <span class="absolute inline-flex size-full rounded-full bg-accent opacity-60 motion-safe:animate-ping"></span>
          <span class="relative inline-flex size-2.5 rounded-full bg-accent"></span>
        </span>
        {t.hero.status}
      </p>

      <p class="mt-6 text-sm font-semibold tracking-wide text-accent uppercase">{t.hero.eyebrow}</p>
      <h1 id="hero-title" class="text-fluid-hero mt-3 font-extrabold">
        {t.hero.title}
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted sm:text-xl">{t.hero.lead}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button
          href={whatsappUrl(t.whatsapp.default)}
          external
          size="lg"
          icon="simple-icons:whatsapp"
          track="click_whatsapp"
          data-track-location="hero"
        >
          {t.cta.whatsapp}
        </Button>
        <Button
          href={pathFor('cv', lang)}
          variant="secondary"
          size="lg"
          icon="lucide:arrow-right"
          iconPosition="end"
          track="view_cv"
          data-track-location="hero"
        >
          {t.cta.recruiter}
        </Button>
      </div>
    </div>

    <!-- Ilustración decorativa construida con HTML: representa el trabajo de administración de catálogo. -->
    <div class="relative mx-auto hidden w-full max-w-md sm:block" aria-hidden="true">
      <div class="absolute -inset-6 -z-10 rounded-[2.5rem] bg-accent-soft"></div>
      <div class="rounded-3xl border border-line bg-surface p-5 shadow-xl shadow-black/5">
        <div class="flex items-center justify-between">
          <span class="text-sm font-semibold">{t.hero.visual.productCard}</span>
          <Icon name="lucide:package-check" class="size-5 text-accent" />
        </div>
        <div class="mt-4 grid grid-cols-[96px_1fr] gap-4">
          <div class="grid aspect-square place-items-center rounded-2xl bg-surface-muted">
            <Icon name="lucide:image" class="size-8 text-muted" />
          </div>
          <div class="space-y-2 pt-1">
            <div class="h-3 w-4/5 rounded-full bg-ink/80"></div>
            <div class="h-2.5 w-3/5 rounded-full bg-line"></div>
            <div class="h-2.5 w-2/5 rounded-full bg-line"></div>
            <div class="mt-3 h-4 w-1/3 rounded-full bg-accent/80"></div>
          </div>
        </div>
        <ul class="mt-5 grid grid-cols-2 gap-2">
          {t.hero.visual.checklist.map((item) => (
            <li class="flex items-center gap-2 rounded-xl bg-surface-muted px-3 py-2 text-sm">
              <Icon name="lucide:circle-check" class="size-4 shrink-0 text-accent" />
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="relative mt-4 ml-auto w-11/12 rounded-3xl border border-line bg-surface p-5 shadow-xl shadow-black/5 sm:-mt-2 sm:mr-[-1.5rem]">
        <p class="text-xs font-semibold tracking-wide text-muted uppercase">
          {t.hero.visual.channelsTitle}
        </p>
        <ul class="mt-3 space-y-2">
          {channels.map((channel) => (
            <li class="flex items-center justify-between text-sm">
              <span class="font-medium">{channel}</span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-semibold text-accent">
                <span class="size-1.5 rounded-full bg-accent" />
                {t.hero.visual.published}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
