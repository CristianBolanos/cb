---
import { Icon } from 'astro-icon/components';
import ChoiceGroup from '@/components/contact/ChoiceGroup.astro';
import { SITE } from '@/config/site';
import { getLangFromUrl, useTranslations } from '@/i18n';
import { pathFor } from '@/i18n/routes';
import { withBase } from '@/lib/url';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const f = t.contact.form;

const field =
  'mt-2 block w-full rounded-2xl border border-line bg-surface px-4 py-3 text-base text-ink placeholder:text-muted/70 focus:border-accent focus:outline-2 focus:outline-offset-0 focus:outline-accent/40 aria-[invalid=true]:border-red-600';
const label = 'block text-sm font-semibold text-ink';
const error = 'mt-2 hidden text-sm font-medium text-red-700 dark:text-red-400';
---

<form
  action={SITE.formEndpoint}
  method="POST"
  novalidate
  class="space-y-6"
  data-contact-form
  data-messages={JSON.stringify({
    required: f.required,
    invalidEmail: f.invalidEmail,
    tooShort: f.tooShort,
    consentRequired: f.consentRequired,
    sending: f.sending,
    submit: f.submit,
  })}
>
  <input type="hidden" name="_subject" value={f.subject} />
  <!-- Campo trampa para bots (Formspree descarta los envíos que lo llenan). -->
  <div class="hidden" aria-hidden="true">
    <label>
      No llenar <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <ChoiceGroup
    name="perfil"
    legend={f.profile}
    options={[
      { value: 'negocio', label: f.profileBusiness },
      { value: 'reclutador', label: f.profileRecruiter },
    ]}
  />

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="nombre" class={label}>
        {f.name}
      </label>
      <input
        id="nombre"
        name="nombre"
        type="text"
        required
        maxlength="100"
        autocomplete="name"
        class={field}
        aria-describedby="nombre-error"
      />
      <p id="nombre-error" class={error}></p>
    </div>
    <div>
      <label for="email" class={label}>
        {f.email}
      </label>
      <input
        id="email"
        name="email"
        type="email"
        required
        maxlength="150"
        autocomplete="email"
        inputmode="email"
        class={field}
        aria-describedby="email-error"
      />
      <p id="email-error" class={error}></p>
    </div>
  </div>

  <ChoiceGroup
    name="servicio"
    legend={f.service}
    options={Object.entries(f.serviceOptions).map(([value, label]) => ({ value, label }))}
    data-service-group
  />

  <ChoiceGroup
    name="presupuesto"
    legend={f.budget}
    options={f.budgetOptions.map((option) => ({ value: option, label: option }))}
    data-budget-group
  />

  <div>
    <label for="mensaje" class={label}>
      {f.message}
    </label>
    <textarea
      id="mensaje"
      name="mensaje"
      required
      minlength="10"
      maxlength="2000"
      rows="5"
      placeholder={f.messagePlaceholder}
      class={field}
      aria-describedby="mensaje-error"
    ></textarea>
    <p id="mensaje-error" class={error}></p>
  </div>

  <div>
    <label class="flex items-start gap-3 text-sm text-muted">
      <input
        id="consentimiento"
        type="checkbox"
        name="consentimiento"
        value="si"
        required
        class="mt-0.5 size-5 shrink-0 accent-[var(--accent)]"
        aria-describedby="consentimiento-error"
      />
      <span>
        {f.consent}{' '}
        <a
          href={withBase(pathFor('privacy', lang))}
          class="font-medium text-accent underline underline-offset-4"
        >
          {f.consentLink}
        </a>
        .
      </span>
    </label>
    <p id="consentimiento-error" class={error}></p>
  </div>

  <button
    type="submit"
    class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-accent px-6 font-semibold text-accent-contrast transition-colors hover:bg-accent-hover disabled:cursor-wait disabled:opacity-70 sm:w-auto"
  >
    <Icon name="lucide:send" class="size-5" aria-hidden="true" data-submit-icon />
    <span data-submit-label>{f.submit}</span>
  </button>

  <div role="status" aria-live="polite" class="empty:hidden" data-form-status></div>
  <template data-success-template>
    <p class="flex items-start gap-3 rounded-2xl bg-accent-soft p-4 font-medium text-ink">
      <Icon
        name="lucide:circle-check"
        class="mt-0.5 size-5 shrink-0 text-accent"
        aria-hidden="true"
      />
      {f.success}
    </p>
  </template>
  <template data-error-template>
    <p class="flex items-start gap-3 rounded-2xl border border-red-600/40 p-4 font-medium text-ink">
      <Icon
        name="lucide:circle-alert"
        class="mt-0.5 size-5 shrink-0 text-red-600"
        aria-hidden="true"
      />
      {f.error}
    </p>
  </template>
</form>

<script>
  import { initContactForm } from '@/scripts/contact-form';
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(initContactForm);
</script>
