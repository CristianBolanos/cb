---
interface Props {
  tone?: 'neutral' | 'accent';
}

const { tone = 'neutral' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium',
    tone === 'accent' ? 'bg-accent-soft text-accent' : 'border border-line text-muted',
  ]}
>
  <slot />
</span>
