---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getLangFromUrl, useTranslations } from '@/i18n';
import { getTestimonials } from '@/lib/content';

// La sección solo aparece cuando hay testimonios en src/content/testimonials.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const testimonials = await getTestimonials(lang);
---

{testimonials.length > 0 && (
  <section class="section-y bg-surface-muted" aria-labelledby="testimonials-title">
    <div class="container-page">
      <SectionHeading
        id="testimonials-title"
        eyebrow={t.testimonials.eyebrow}
        title={t.testimonials.title}
      />
      <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {testimonials.map(({ data }) => (
          <li>
            <figure class="flex h-full flex-col rounded-3xl border border-line bg-surface p-6">
              <blockquote class="flex-1 text-ink">“{data.quote}”</blockquote>
              <figcaption class="mt-6 text-sm">
                <span class="block font-semibold">{data.name}</span>
                <span class="text-muted">
                  {data.role}
                  {data.company && `, ${data.company}`}
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
