---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getLangFromUrl, useTranslations } from '@/i18n';

interface Props {
  items: CollectionEntry<'faq'>[];
}

const { items } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<section class="section-y" aria-labelledby="faq-title">
  <div class="container-page grid gap-10 lg:grid-cols-[1fr_1.6fr]">
    <SectionHeading id="faq-title" eyebrow={t.faq.eyebrow} title={t.faq.title} />
    <div class="divide-y divide-line border-y border-line">
      {items.map(({ data }) => (
        <details class="group py-2">
          <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 py-3 font-semibold text-ink [&::-webkit-details-marker]:hidden">
            {data.question}
            <Icon
              name="lucide:chevron-down"
              class="size-5 shrink-0 text-muted transition-transform group-open:rotate-180"
              aria-hidden="true"
            />
          </summary>
          <p class="pb-4 text-muted">{data.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
