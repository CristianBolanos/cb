---
import { Icon } from 'astro-icon/components';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getLangFromUrl, useTranslations } from '@/i18n';
import { pathFor } from '@/i18n/routes';
import { getServices } from '@/lib/content';
import { withBase } from '@/lib/url';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const services = await getServices(lang);
---

<section class="section-y" aria-labelledby="services-title">
  <div class="container-page">
    <SectionHeading
      id="services-title"
      eyebrow={t.services.eyebrow}
      title={t.services.title}
      intro={t.services.intro}
    />
    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {services.map(({ data }) => (
        <li class="group relative flex flex-col rounded-3xl border border-line bg-surface p-6 transition-colors hover:border-accent/50 sm:p-7">
          <span class="grid size-12 place-items-center rounded-2xl bg-accent-soft text-accent">
            <Icon name={data.icon} class="size-6" aria-hidden="true" />
          </span>
          <h3 class="mt-5 text-xl">
            <a
              href={withBase(`${pathFor('services', lang)}#${data.serviceId}`)}
              class="after:absolute after:inset-0"
            >
              {data.title}
            </a>
          </h3>
          <p class="mt-3 text-muted">{data.summary}</p>
          <p class="mt-5 border-t border-line pt-4 text-sm font-medium text-ink">{data.outcome}</p>
          <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-accent">
            {t.cta.viewDetails}
            <Icon
              name="lucide:arrow-right"
              class="size-4 transition-transform group-hover:translate-x-1"
              aria-hidden="true"
            />
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
