---
/** Grupo de opciones tipo "chip" (radios accesibles, cómodos de tocar en el celular). */
interface Props {
  name: string;
  legend: string;
  options: { value: string; label: string }[];
  checked?: string;
  columns?: 1 | 2;
  hidden?: boolean;
  [key: `data-${string}`]: unknown;
}

const {
  name,
  legend,
  options,
  checked = options[0]?.value,
  columns = 2,
  hidden,
  ...rest
} = Astro.props;
---

<fieldset hidden={hidden} {...rest}>
  <legend class="block text-sm font-semibold text-ink">{legend}</legend>
  <div class:list={['mt-2 grid gap-3', columns === 2 && 'sm:grid-cols-2']}>
    {options.map(({ value, label }) => (
      <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-2xl border border-line bg-surface px-4 py-2 has-[:checked]:border-accent has-[:checked]:bg-accent-soft has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-accent">
        <input
          type="radio"
          name={name}
          value={value}
          checked={value === checked}
          class="size-4 shrink-0 accent-[var(--accent)]"
        />
        <span>{label}</span>
      </label>
    ))}
  </div>
</fieldset>
